TAVILY_API_KEY=your-key-here

# Azure backend endpoints:
# Set these in the web app container. Do not use localhost in Azure.
OLLAMA_URL=http://learngraph-ollama.westus2.azurecontainer.io:11434
OLLAMA_MODEL=qwen3:1.7b
LLM_TIMEOUT_MS=12000
# ANTHROPIC_API_KEY=your-key-here

GBRAIN_URL=http://learngraph-gbrain.westus2.azurecontainer.io:4100
# Preferred for hosted GBrain v0.33+ OAuth client-credentials auth:
# GBRAIN_CLIENT_ID=your-gbrain-oauth-client-id
# GBRAIN_CLIENT_SECRET=your-gbrain-oauth-client-secret
# Legacy bearer auth fallback:
# GBRAIN_SHARED_SECRET=your-gbrain-bearer-token
# GBRAIN_SESSION_TTL_MS=259200000

# Local dev only:
# OLLAMA_URL=http://localhost:11434
# GBRAIN_URL=http://localhost:4100
