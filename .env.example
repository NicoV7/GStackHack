# Local GBrain + tunnel for hackathon demo:
# 1. Run: gbrain serve --http --port 4100
# 2. Tunnel port 4100 with ngrok/cloudflared/etc.
# 3. Set this to the tunnel origin that exposes /mcp.
# GBRAIN_URL=https://your-tunnel.example.com
# GBRAIN_SESSION_TTL_MS=259200000
