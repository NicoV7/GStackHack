TAVILY_API_KEY=your-key-here

# LLM cascade: Ollama (free) → Anthropic → Gemini
# Set OLLAMA_URL to a tunnel URL for Vercel to reach your local Ollama
# OLLAMA_URL=https://your-ollama-tunnel.example.com
# OLLAMA_MODEL=qwen3:8b
# ANTHROPIC_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here

# Local GBrain + tunnel for hackathon demo:
# 1. Run: gbrain serve --http --port 4100
# 2. Tunnel port 4100 with ngrok/cloudflared/etc.
# 3. Set this to the tunnel origin that exposes /mcp.
# GBRAIN_URL=https://your-tunnel.example.com
# GBRAIN_SESSION_TTL_MS=259200000
