TAVILY_API_KEY=your-key-here

# Local demo backend endpoints:
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
LLM_TIMEOUT_MS=90000
BROWSER_SEARCH_TIMEOUT_MS=1500
FAST_LOCAL_DEMO=true
# ANTHROPIC_API_KEY=your-key-here

# Local demo memory uses browser localStorage by default.
DISABLE_GBRAIN=true
# Optional local GBrain MCP if you want to test it manually:
# GBRAIN_URL=http://localhost:4100
# GBRAIN_SHARED_SECRET=your-gbrain-bearer-token
# GBRAIN_SESSION_TTL_MS=259200000
